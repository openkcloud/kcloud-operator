# ============================================================
# deploy.env.example: NPU Operator 배포 환경 변수 예시
# 상세: 이 파일을 deploy.env 로 복사 후 값을 채워 install.sh 에서 사용합니다.
#       deploy.env 는 .gitignore 에 포함되어 있으므로 커밋되지 않습니다.
# 사용법:
#   cp deploy.env.example deploy.env
#   vi deploy.env        # REGISTRY 를 반드시 설정하세요
#   bash install.sh
# 생성일: 2026-06-02 | 수정일: 2026-09-09 (VENDOR_REGISTRY 추가)
# ============================================================

# [필수] kcloud 가 빌드하는 이미지를 pull 할 레지스트리 주소 (host:port[/project])
# operator / node-manager / host-exec / furiosa-exporter / 드라이버 설치기 /
# Furiosa 통합 device-plugin / Tenstorrent device-plugin 의 prefix 로 주입됩니다.
# 예: REGISTRY=<your-registry>/kcloud
REGISTRY=

# [선택] 벤더(3rd-party) 이미지를 pull 할 미러 주소.
# 미지정이면 REGISTRY 와 같은 곳으로 봅니다(사설 미러 하나에 전부 올려 둔 기존 방식).
# 벤더 이미지만 upstream(nvcr.io / docker.io / registry.k8s.io)에서 직접 받으려면
# 빈 문자열을 명시합니다: VENDOR_REGISTRY=""
# 미러 경로 규약은 upstream 의 org 경로를 그대로 유지하는 것입니다:
#   <VENDOR_REGISTRY>/nvidia/k8s-device-plugin, <VENDOR_REGISTRY>/bitnamilegacy/kubectl 등
#VENDOR_REGISTRY=

# [선택] Helm 릴리스 이름 (기본값: kcloud-operator)
RELEASE=kcloud-operator

# [선택] 배포 대상 네임스페이스 (없으면 자동 생성됨, 기본값: kcloud)
NAMESPACE=kcloud

# [선택] 차트 경로 또는 OCI 레퍼런스 (기본값: 이 스크립트 위치의 ./  )
# 로컬 차트: CHART=./
# OCI 차트:  CHART=oci://<your-registry>/charts/kcloud-operator
CHART=./

# [선택] 추가 helm 인수 (공백 구분, -f override 파일 등)
# 예: EXTRA_ARGS="-f values-airgap.yaml --set furiosa.enabled=false"
EXTRA_ARGS=
